		"activities": [
			{
				"name": "Lookup_Metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT * FROM dbo.MetadataConfig ',\n    'WHERE ProcessId = ',\n    string(pipeline().parameters.ProcessId),\n    ' AND IsActive = 1'\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Generic",
						"type": "DatasetReference",
						"parameters": {
							"ServerName": "localhost\\SQLEXPRESS",
							"DatabaseName": "ADF_Metadata",
							"SchemaName": "dbo",
							"TableName": "MetadataConfig"
						}
					}
				}
			},
			{
