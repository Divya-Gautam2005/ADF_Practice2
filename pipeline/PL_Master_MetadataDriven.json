{
	"name": "PL_Master_MetadataDriven",
	"properties": {
		"activities": [
			{
				"name": "Lookup_MetadataConfig",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT * FROM dbo.MetadataConfig WHERE IsActive = 1 AND TriggerType = ''',\n    if(\n        equals(pipeline().TriggerType,'Event'),\n        'Event',\n        'Schedule'\n    ),\n    ''' ORDER BY ExecutionOrder'\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Generic",
						"type": "DatasetReference",
						"parameters": {
							"ServerName": "localhost\\SQLEXPRESS",
							"DatabaseName": "ADF_Metadata",
							"SchemaName": "dbo",
							"TableName": "MetadataConfig"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_ProcessMetadata",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_MetadataConfig",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_MetadataConfig').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "SW_SourceType",
							"type": "Switch",
							"dependsOn": [
								{
									"activity": "IF_DependencyOK",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@if(\n    equals(item().SourceType,'ADLS'),\n    concat('ADLS_',item().SourceFileFormat),\n    item().SourceType\n)",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "OnPremSQL",
										"activities": [
											{
												"name": "CP_OnPremSQL_To_ADLS_Raw",
												"type": "Copy",
												"dependsOn": [
													{
														"activity": "SV_Set_RawFileName",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "SqlServerSource",
														"sqlReaderQuery": {
															"value": "@if(\n    equals(item().LoadType, 'INCREMENTAL'),\n    concat(\n        'SELECT * FROM ',\n        item().SourceSchema,\n        '.',\n        item().SourceObject,\n        ' WHERE ',\n        item().WatermarkColumn,\n        ' > COALESCE((',\n        'SELECT TRY_CONVERT(datetime2, LastWatermarkValue) ',\n        'FROM ADF_Metadata.dbo.Watermark ',\n        'WHERE ProcessId = ',\n        string(item().ProcessId),\n        '), CAST(''1900-01-01'' AS datetime2))'\n    ),\n    concat(\n        'SELECT * FROM ',\n        item().SourceSchema,\n        '.',\n        item().SourceObject\n    )\n)",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "DelimitedTextSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "DelimitedTextWriteSettings",
															"quoteAllText": true,
															"fileExtension": ".txt"
														}
													},
													"enableStaging": false,
													"validateDataConsistency": true,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_SQL_Generic",
														"type": "DatasetReference",
														"parameters": {
															"ServerName": "localhost\\SQLEXPRESS",
															"DatabaseName": "@item().SourceDatabase",
															"SchemaName": "@item().SourceSchema",
															"TableName": "@concat(item().SourceSchema,'.',item().SourceObject)"
														}
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_Generic",
														"type": "DatasetReference",
														"parameters": {
															"FolderPath": {
																"value": "@variables('v_RawFolder')",
																"type": "Expression"
															},
															"Filename": {
																"value": "@variables('v_RawFileName')",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "SV_Set_RecordCount_OnPremSQL",
												"type": "SetVariable",
												"dependsOn": [
													{
														"activity": "CP_OnPremSQL_To_ADLS_Raw",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"variableName": "v_RecordCount",
													"value": {
														"value": "@string(activity('CP_OnPremSQL_To_ADLS_Raw').output.rowsCopied)",
														"type": "Expression"
													}
												}
											},
											{
												"name": "EP_ADLS_To_SQL_Staging",
												"type": "ExecutePipeline",
												"dependsOn": [
													{
														"activity": "SV_Set_RecordCount_OnPremSQL",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_ADLS_To_SQL_Generic",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"ProcessId": {
															"value": "@item().ProcessId",
															"type": "Expression"
														},
														"PipelineRunId": {
															"value": "@pipeline().RunId",
															"type": "Expression"
														},
														"RawFolder": {
															"value": "@variables('v_RawFolder')",
															"type": "Expression"
														},
														"RawFileName": {
															"value": "@variables('v_RawFileName')",
															"type": "Expression"
														}
													}
												}
											},
											{
												"name": "SV_Set_RawFolder",
												"type": "SetVariable",
												"dependsOn": [],
												"policy": {
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"variableName": "v_RawFolder",
													"value": {
														"value": "@concat(\n    replace(item().TargetFolder,'/raw/',''),\n    formatDateTime(utcnow(),'yyyy-MM-dd'),\n    '/',\n    string(item().ProcessId),\n    '/'\n)",
														"type": "Expression"
													}
												}
											},
											{
												"name": "SV_Set_RawFileName",
												"type": "SetVariable",
												"dependsOn": [
													{
														"activity": "SV_Set_RawFolder",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"variableName": "v_RawFileName",
													"value": {
														"value": "@concat(\n    item().SourceObject,\n    '_',\n    string(item().ProcessId),\n    '_',\n    formatDateTime(utcnow(),'yyyyMMdd_HHmmss'),\n    '.csv'\n)",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"value": "ADLS_CSV",
										"activities": [
											{
												"name": "CP_ADLS_To_ADLS_Raw",
												"type": "Copy",
												"dependsOn": [
													{
														"activity": "SV_Set_RawFileName_ADLS_CSV",
