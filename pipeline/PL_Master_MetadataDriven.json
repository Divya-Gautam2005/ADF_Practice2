													"value": {
														"value": "@concat(\n    replace(item().SourceFileName,'.csv',''),\n    '_',\n    string(item().ProcessId),\n    '_',\n    formatDateTime(utcnow(),'yyyyMMdd_HHmmss'),\n    '.csv'\n)",
														"type": "Expression"
													}
												}
											},
											{
