														"RawFileName": {
															"value": "@variables('v_RawFileName')",
															"type": "Expression"
														}
													}
												}
											}
										]
									},
									{
										"value": "AzureSQL",
										"activities": [
											{
												"name": "WAIT_AzureSQL_Skipped",
												"type": "Wait",
												"dependsOn": [],
