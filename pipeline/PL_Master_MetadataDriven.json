												"userProperties": [],
												"typeProperties": {
													"variableName": "v_RawFolder",
													"value": {
														"value": "@concat(\n    replace(item().TargetFolder,'/raw/',''),\n    formatDateTime(utcnow(),'yyyy-MM-dd'),\n    '/',\n    string(item().ProcessId),\n    '/'\n)",
														"type": "Expression"
													}
												}
											},
											{
												"name": "SV_Set_RawFileName_ADLS_CSV",
												"type": "SetVariable",
												"dependsOn": [
													{
														"activity": "SV_Set_RawFolder_CSV",
														"dependencyConditions": [
